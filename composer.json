{
    "name": "francisco-cardoso/artsoft-connector",
    "description": "Framework-agnostic PHP package for connecting to the ARTSOFT ERP system",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "psr/log": "^2.0|^3.0",
        "ext-curl": "*",
        "ext-simplexml": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.12",
        "phpunit/phpunit": "^11.0",
        "illuminate/console": "^12.58",
        "illuminate/support": "^12.58"
    },
    "suggest": {
        "illuminate/console": "Required to use the artsoft:publish Artisan command (^10.0|^11.0|^12.0)",
        "illuminate/support": "Required to use the Laravel service provider (^10.0|^11.0|^12.0)"
    },
    "autoload": {
        "psr-4": {
            "FranciscoCardoso\\ArtsoftConnector\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FranciscoCardoso\\ArtsoftConnector\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "FranciscoCardoso\\ArtsoftConnector\\ServiceProviders\\Laravel\\ArtsoftLaravelServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
