{
    "name": "francisco-cardoso/artsoft-connector",
    "description": "Framework-agnostic PHP package for connecting to the ARTSOFT ERP system",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "psr/log": "^2.0|^3.0",
        "ext-curl": "*",
        "ext-simplexml": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.12",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "FranciscoCardoso\\ArtsoftConnector\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FranciscoCardoso\\ArtsoftConnector\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}